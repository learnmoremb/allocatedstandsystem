SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Council Stand Allocation <no-reply@council.local>
CURRENCY=USD
# Stand price model service (pricing/), see README
PRICING_URL=http://127.0.0.1:8000
