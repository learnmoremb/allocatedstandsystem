# ---- Copy to .env and fill in before running: docker compose up -d --build ----

# Address people use to open the app (used for email links and CORS)
PUBLIC_URL=http://YOUR_SERVER_IP:8080

# Host ports on the server
APP_PORT=8080        # frontend (open this one in the firewall)
API_PORT=5000        # backend API (optional to open; the frontend already forwards /api)
MONGO_PORT=27017     # MongoDB, bound to 127.0.0.1 only

# MongoDB (letters and digits only, so they are safe inside the connection string)
MONGO_ROOT_USER=standadmin
MONGO_ROOT_PASSWORD=change-me
MONGO_DB=stand_allocation

# Long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me
JWT_EXPIRES=1d
MAX_ACTIVE_STANDS_PER_USER=1

# First admin, created on startup only if the database has no admin.
# They must change this password at first login.
ADMIN_EMAIL=admin@council.gov
ADMIN_PASSWORD=change-me

# Email (leave SMTP_HOST empty to log emails instead of sending)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Council Stand Allocation <no-reply@council.local>
CURRENCY=USD
